  "fittings": {
    "elbow90": {
      "name": "Codo 90°",
      "K": 0.22,
      "status": "ok",
      "src": "ASHRAE, Principles of HVAC 9.ª ed., suplemento «Fitting Loss Coefficients», accesorio 3-1: codo circular de radio suave, r/D = 1.0. Con r/D = 1.5 baja a 0.15; un codo a inglete sin álabes sube a 1.2."
    },
    "elbow45": {
      "name": "Codo 45°",
      "K": 0.13,
      "status": "ok",
      "src": "Codo 90° (0.22) por el factor de ángulo 0.60 para 45° del mismo accesorio 3-1 de ASHRAE."
    },
    "tee": {
      "name": "Tee (derivación)",
      "K": 1.1,
      "status": "ok",
      "src": "McGill AirFlow, Duct System Design Guide (2003), tabla 1.3: tee recta con flujo hacia el ramal y Vb/Vc ≈ 1 → 1.08, referido al ramal. ASHRAE (accesorio 5-10) da 1.2 a 1.6 y Engineering ToolBox 0.3: depende mucho de las relaciones de área y caudal."
    },
    "reducer": {
      "name": "Reducción",
      "K": 0.05,
      "status": "unverified",
      "src": "[No verificado] Contracción gradual (≤ 45°), referida a la sección menor. Valor recordado de ASHRAE SD4-1; Engineering ToolBox la toma como 0. Una contracción brusca ronda 0.5·(1 − A2/A1)."
    },
    "expansion": {
      "name": "Expansión",
      "K": 0.25,
      "status": "formula",
      "src": "Expansión brusca, Borda-Carnot: K = (1 − A1/A2)² referido a la sección menor. 0.25 corresponde a A2/A1 = 2. Una expansión gradual pierde menos."
    },
    "damper": {
      "name": "Damper (abierto)",
      "K": 0.6,
      "status": "ok",
      "src": "ASHRAE Handbook Fundamentals 2009 (SI), accesorio CD9-1: mariposa circular, D/D0 = 0.98, a 0°. Leído en una copia pública, no en el original. Las tablas de placa delgada dan cerca de 0.2."
    },
    "diffuser": {
      "name": "Diffuser",
      "K": 3,
      "status": "unverified",
      "src": "[No verificado] Orden de magnitud: los catálogos de difusores de techo suelen dar una presión total de 2 a 5 veces la presión dinámica del cuello. Sustitúyelo por K = ΔP de catálogo / Pv."
    },
    "grille": {
      "name": "Grille",
      "K": 3,
      "status": "ok",
      "src": "Engineering ToolBox, «Air Duct Components – Minor Dynamic Loss Coefficients»: rejilla con relación de área libre 0.7 → 3 (0.6 → 4; 0.5 → 6)."
    }
  },
